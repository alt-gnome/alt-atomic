<?xml version="1.0" encoding="UTF-8"?>
<component type="operating-system">
  <id>org.alt_atomic.Onyx</id>
  <name>ALT Atomic Onyx</name>
  <summary>Atomic desktop operating system with GNOME</summary>
  <description>
    <p>
      ALT Atomic Onyx is a modern, image-based Linux
      distribution built on ALT Linux and featuring
      the GNOME desktop environment.
    </p>
  </description>

  <x-variants>
    <variant>
      <image>altlinux.space/alt-atomic/onyx/stable:latest</image>
      <name>ALT Atomic Onyx</name>
      <summary>
        Standard image for everyday desktop use
      </summary>
      <description>
        The standard ALT Atomic Onyx image with GNOME,
        designed for everyday computing and general-purpose
        desktop workloads.
      </description>
    </variant>
    <variant>
      <image>altlinux.space/alt-atomic/onyx-nvidia/stable:latest</image>
      <name>ALT Atomic Onyx (NVIDIA)</name>
      <summary>
        Desktop image with integrated proprietary NVIDIA drivers
      </summary>
      <description>
        ALT Atomic Onyx with preinstalled proprietary
        NVIDIA graphics drivers, intended for systems
        equipped with supported NVIDIA GPUs.
      </description>
    </variant>
  </x-variants>

  <url type="homepage">https://alt-atomic.org/</url>
  <url type="help">https://alt-atomic.org/en/</url>
  <url type="bugtracker">https://altlinux.space/alt-atomic/onyx/issues</url>
  <url type="vcs-browser">https://altlinux.space/alt-atomic/onyx</url>

  <metadata_license>FSFAP</metadata_license>
  <developer id="org.alt_atomic">
    <name>ALT Atomic Team</name>
  </developer>

  <releases>
    <release version="0.6.1" date="2026-10-13">
      <description>
        <ol>
          <li>Fixed offline installation in live iso.</li>
          <li>Fixed session-keeper extension for gnome 51.</li>
        </ol>
      </description>
    </release>
  </releases>
</component>
