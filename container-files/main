ARG ARG_IMAGE

FROM $ARG_IMAGE

ARG ARG_BUILD
ARG ARG_IMAGE
ARG ARG_IMAGE_TYPE
ARG ARG_VERSION

ENV BUILD=$ARG_BUILD
ENV IMAGE_NAME="onyx"
ENV IMAGE_TYPE=$ARG_IMAGE_TYPE
ENV IMAGE=$ARG_IMAGE
ENV VERSION=$ARG_VERSION

RUN --mount=type=bind,source=./src/${ARG_BUILD}.yml,target=/etc/apm/image.yml \
    --mount=type=bind,source=./src/resources,target=/etc/apm/resources \
    apm system image build

# Lint image
RUN echo -e "\033[1;33m$(bootc container lint)\033[0m"

WORKDIR /

CMD ["/sbin/init"]
