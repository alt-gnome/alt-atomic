[Desktop Entry]
# Translators: app name should be translated
Name=ALT Atomic Installer
Comment=Installer of ALT Atomic
# Translators: keep number of ';'
Keywords=atomic;installer;
Exec=/usr/libexec/ready-set --conf-file /usr/share/atomic-installer/config
Icon=alt-atomic
Terminal=false
Type=Application
Categories=GNOME;GTK;System;
StartupNotify=true
X-SingleMainWindow=true
X-Purism-FormFactor=Workstation;Mobile;
X-GNOME-Gettext-Domain=atomic-installer
